# Copy to .env and fill in from your Supabase project (Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Optional: Vexo analytics key.
EXPO_PUBLIC_VEXO_KEY=
# Optional: Sentry DSN for crash reporting (release builds only).
EXPO_PUBLIC_SENTRY_DSN=
# Optional: environment tag sent with error reports (development / preview / production).
EXPO_PUBLIC_APP_ENV=
# Stripe publishable key for the in-app shop (secret key lives in Supabase secrets).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: Apple Pay merchant ID, must match app.json's Stripe plugin config.
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.afifistudio.arsenalclone
