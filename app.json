{
  "expo": {
    "name": "arsenal-clone",
    "slug": "arsenal-clone",
    "version": "1.0.0",
    "scheme": "arsenal-clone",
    "platforms": ["ios", "android"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#000000"
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "The Arsenal adds upcoming fixtures to your calendar when you choose to sync them."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afifistudio.arsenalclone"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.afifistudio.arsenalclone"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f28948eb-c6cf-459e-bb8a-1d329fb88916"
      }
    }
  }
}
